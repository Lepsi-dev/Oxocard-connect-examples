#------------------------------------------------------------------------------------
# 
# Mini DF PLayer - MP3 Player
#
#------------------------------------------------------------------------------------
#
# Mini DF Player - MP3 Player with RX/TX UART Protocol
#
# datasheet: 
#  - https://wiki.dfrobot.com/DFPlayer_Mini_SKU_DFR0299
#
#
# Author: Lepsi-dev
# Version: 0.8 2025-02-16
#
#------------------------------------------------------------------------------------

# UART command =  [ strt,  ver,  len,  cmd, feedback, par1, par2, chksHig,checkLow end  ]
command:byte[10] = [ 0x7E, 0xFF, 0x06, 0x00, 0x00    , 0x00, 0x00, 0x00, 0x00, 0xEF ]
run = 0

def getCheckSum():
	sum:long = 0
	calc:int

	for i in 6
		sum = sum + command[i+1]
	sum = ~sum +1
	# sum = 0x010000 - sum
	command[7] = (sum & 0xFF00) >>8
	command[8] = (sum & 0x00FF) 
    


def sendCommand(cmd:byte,par1:byte,par2:byte, feedback:byte)->int:
    ret:byte[256]

	command[3] = cmd
	command[4] = feedback
	command[5] = par1
	command[6] = par2
	getCheckSum()
    
	print( "Command=" + byteToHex(command[0]) + " " + byteToHex(command[1]) + " " + byteToHex(command[2]) + " " + byteToHex(command[3]) + " " + byteToHex(command[4]) + " " + byteToHex(command[5]) + " " + byteToHex(command[6]) + " " + byteToHex(command[7]) + " " + byteToHex(command[8]) + " " + byteToHex(command[9]))
	writeUART(10, command)
	delay(10)
	if feedback==1
		ret = readUART(10)
		print( "Return =" + byteToHex(ret[0]) + " " + byteToHex(ret[1]) + " " + byteToHex(ret[2]) + " " + byteToHex(ret[3]) + " " + byteToHex(ret[4]) + " " + byteToHex(ret[5]) + " " + byteToHex(ret[6]) + " " + byteToHex(ret[7]) + " " + byteToHex(ret[8]) + " " + byteToHex(ret[9]))
		return ret[6]
	else
		return 0x00

def next():
	sendCommand(0x01,0x00, 0x00, 0x00)

def prev():
	sendCommand(0x02,0x00, 0x00, 0x00)

def playFile( fileno:byte):
	sendCommand(0x03,0x00, fileno, 0x00)

def volumePlus():
	sendCommand(0x04,0x00, 0x00, 0x00)

def volumeMinus():
	sendCommand(0x05,0x00, 0x00, 0x00)

def setVolume( volume:byte): # 0-30
	if volume > 30
		volume = 30
	if volume < 0
		volume = 0
	sendCommand(0x06,0x00, volume, 0x00)

def setEQ( eq:byte): 			 # 0,1,2,3,4,5 = normal, Pop, Rock, Jazz, Classic, Base
	sendCommand(0x07,0x00, eq, 0x00)

def setPlayback( playback:byte): # 0,1,2,3,4   = Repeat, folder repeat, single repeat, random
	sendCommand(0x08,0x00, playback, 0x00)
	
def setStandby():
	sendCommand(0x0A,0x00, 0x00, 0x00)

def setNormalMode():
	sendCommand(0x0B,0x00, 0x00, 0x00)

def reset():
	sendCommand(0x0C,0x00, 0x00, 0x00)

def playback():
	sendCommand(0x0D,0x00, 0x00, 0x00)

def pause():
	sendCommand(0x0E,0x00, 0x00, 0x00)

def setFolder( folder:byte):
	sendCommand(0x0F,0x00, folder, 0x00)

def startReplay():
	sendCommand(0x11,0x00, 0x01, 0x00)

def stopReplay():
	sendCommand(0x11,0x00, 0x00, 0x00)

def getVolume() -> byte
	return sendCommand(0x43,0x00, 0x00, 0x01)

def getStatus() -> byte
	return sendCommand(0x42,0x00, 0x00, 0x01)

def getEQ()->byte
	return sendCommand(0x44,0x00, 0x00, 0x01)

def getPlaybackMode()->byte
	return sendCommand(0x45,0x00, 0x00, 0x01)

def getVersion()->byte
	return sendCommand(0x46,0x00, 0x00, 0x01)

def getFiles()->byte
	return sendCommand(0x47,0x00, 0x00, 0x01)

def getCurrentFile()->byte
	return sendCommand(0x4B,0x00, 0x00, 0x01)

# init
initUART( C_PIN_02, C_PIN_01, 9600 )

background(0,0,0)
textAlignment(TEXT_ALIGN_CENTER)
textFont(FONT_ROBOTO_BOLD_32)
initGPIO(C_PIN_04, INPUT)

reset()
delay(1000)
setNormalMode()
setVolume(15)

def onDraw():
	clear()
	noFill()

	drawCircle( 120, 120, 30)
	drawCircle( 120, 40, 30)
	drawCircle( 120, 200, 30)
	drawCircle( 40, 120, 30)
	drawCircle( 200, 120, 30)

	if readGPIO( C_PIN_04 )
		if run == 1
			delay(500)
			next()
		drawText(120,120-15,">")
		if getButton() == 1
			fill( 0x00, 0x00, 0xff)
			drawCircle( 120, 120, 30)
			drawText(120,120-15,">")
			run = 1
			playback()
	else 
		drawText(120,120-15,"=")
		if getButton() == 1
			fill( 0x00, 0x00, 0xff)
			drawCircle( 120, 120, 30)
			drawText(120,120-15,"=")
			run = 0
			pause()
	
	b = getButton()
	if b == 2 # Vol +
		volumePlus()
		fill( 0x00, 0x00, 0xff)
		drawCircle( 120, 40, 30)
	else if b == 4 # Vol -
		volumeMinus()
		fill( 0x00, 0x00, 0xff)
		drawCircle( 120, 200, 30)
	else if b == 5 # previous song
		prev()
		run = 1
		fill( 0x00, 0x00, 0xff)
		drawCircle( 40, 120, 30)
	else if b == 3 # next song
		next()
		run = 1
		fill( 0x00, 0x00, 0xff)
		drawCircle( 200, 120, 30)
	
	drawText( 120, 40-15, "+")
	drawText( 120, 200-15,"-")
	drawText( 40, 120-15, "<")
	drawText( 200, 120-15, ">")
	
	update()
	delay(200)
